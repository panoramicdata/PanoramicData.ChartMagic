<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <IsPackable>false</IsPackable>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- PDTabSet and PDTab. Their scoped CSS reads Bootstrap custom properties with
         fallbacks, so the demo supplies those from its own theme tokens rather than
         taking a dependency on Bootstrap itself. -->
    <PackageReference Include="PanoramicData.Blazor" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PanoramicData.ChartMagic\PanoramicData.ChartMagic.csproj" />
  </ItemGroup>
</Project>