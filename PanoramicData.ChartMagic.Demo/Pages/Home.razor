@page "/"
@using System.Reflection
@using PanoramicData.ChartMagic.Models
@inject IJSRuntime JS
@inject PanoramicData.ChartMagic.Demo.Services.ComparisonSettings Settings
@inject PanoramicData.ChartMagic.Demo.Services.DocMagicComparer Comparer
@using PanoramicData.ChartMagic.Demo.Services

<PageTitle>ChartMagic</PageTitle>

<header class="page-header">
	<div>
		<h1>ChartMagic <span class="version">@Version</span></h1>
		<p class="lead">
			Charts rendered in your browser by <code>PanoramicData.ChartMagic</code>, running under
			WebAssembly. Every chart is generated from a <code>ChartSpecification</code> and
			inserted as inline SVG &mdash; there is no server and no image file.
		</p>
	</div>
	<div class="mode-picker" role="group" aria-label="Colour mode">
		@foreach (var mode in Modes)
		{
			<button type="button"
					class="mode-button @(mode.Value == _mode ? "active" : null)"
					aria-pressed="@(mode.Value == _mode ? "true" : "false")"
					@onclick="() => SetModeAsync(mode.Value)">
				@mode.Label
			</button>
		}
	</div>
</header>

<p class="notes">
	Each tab holds one sample. Every property of the <code>ChartSpecification</code> is listed
	beside the chart and can be edited: the chart redraws as you change it. Properties still at
	their default are dimmed, so what the sample actually sets stands out. <strong>Reset</strong>
	puts the sample back.
</p>

<div class="status-key">
	<span class="badge working">Working</span> renders as intended
	<span class="badge partial">Partial</span> draws, but not everything asked for
	<span class="badge missing">Not implemented</span> draws nothing
</div>

@if (Settings.IsLocal)
{
	@*
		Only ever rendered on a local development host. The published site never shows this and
		never reads or writes the settings behind it, so an API key cannot end up in the storage
		of the public origin.
	*@
	<div class="comparison-bar">
		@if (_comparison.IsConfigured)
		{
			<span class="comparison-state on">Comparison ready</span>
			<span class="comparison-target">@_comparison.ServerUrl <em>via</em> @_comparison.RelayUrl</span>
			<button type="button" class="reset-button" @onclick="ForgetSettingsAsync">Forget</button>
		}
		else
		{
			<span class="comparison-state off">Comparison off</span>
			<span class="comparison-target">
				Add <code>?docmagic=http://server:8080&amp;key=YOUR_KEY</code> to compare against a
				DocMagic server, with the relay running:
				<code>dotnet run tools/DocMagicRelay.cs</code>
			</span>
		}
	</div>
}

<PDTabSet CssClass="samples" TabMinWidth="auto" TabMaxWidth="none" OnTabSelected="OnTabSelectedAsync">
	@foreach (var sample in _samples)
	{
		<PDTab Title="@sample.Title">
			@{
				var state = StateFor(sample);
			}
			<section class="sample">
				<h2>
					@sample.Title
					<span class="badge @BadgeClass(sample.Status)">@BadgeText(sample.Status)</span>
					<button type="button" class="reset-button" @onclick="() => ResetAsync(sample.Title)">Reset</button>
					@if (state.IsEdited)
					{
						<span class="edited">edited</span>
					}
				</h2>
				<p class="notes">@sample.Notes</p>

				<div class="sample-body">
					<div class="sample-chart">
						<div class="chart">
							<div class="light-only">@((MarkupString)LightSvg(state))</div>
							<div class="dark-only">@((MarkupString)DarkSvg(state))</div>
						</div>

						@if (_comparison.IsConfigured)
						{
							@*
								Directly underneath rather than side by side: both renders are the same size, and a
								difference of a few pixels is far easier to see when one is above the other.
							*@
							var comparison = ComparisonFor(sample.Title);
							<div class="comparison">
								<div class="comparison-heading">
									<span>DocMagic</span>
									@if (comparison.IsRendering)
									{
										<span class="comparison-note">rendering...</span>
									}
									else if (comparison.Result?.Error is { Length: > 0 })
									{
										@* The only button here, and only when there is a reason for one. *@
										<button type="button" class="reset-button" @onclick="() => RetryComparisonAsync(sample.Title)">
											Retry
										</button>
									}
								</div>

								@if (comparison.Result is { } result)
								{
									@if (result.HasImage)
									{
										<img class="comparison-image" src="@result.ImageDataUri" alt="Rendered by DocMagic" />
									}
									else
									{
										<p class="comparison-error">@result.Error</p>
									}
								}
								else if (!comparison.IsRendering)
								{
									<p class="notes">Waiting for the first render.</p>
								}
							</div>
						}
					</div>

					<aside class="sample-detail">
						@*
							One table for the whole specification, with colspan heading rows rather
							than a table per group: separate tables size their columns
							independently, so the names and values stop lining up between them.
						*@
						<table class="detail-table editor-table">
							<tbody>
								@{
									var group = string.Empty;
								}
								@foreach (var property in state.Editors)
								{
									@if (property.Group != group)
									{
										group = property.Group;
										<tr class="section">
											<th colspan="2">@GroupLabel(group)</th>
										</tr>
									}

									<tr class="@(property.IsDefault ? "is-default" : "is-changed")">
										<th scope="row">@property.Name</th>
										<td>
											<div class="editor-cell">
											@switch (property.Kind)
											{
												case EditorKind.Boolean:
													<input type="checkbox"
														   checked="@(SpecificationEditor.Read(state.Specification, property.Name) == "true")"
														   @onchange="e => SetAsync(sample.Title, state, property.Name, e.Value?.ToString()?.ToLowerInvariant())" />
													break;

												case EditorKind.Enumeration:
													<select value="@SpecificationEditor.Read(state.Specification, property.Name)"
															@onchange="e => SetAsync(sample.Title, state, property.Name, e.Value?.ToString())">
														@foreach (var option in property.Options)
														{
															<option value="@option">@(option.Length == 0 ? "(none)" : option)</option>
														}
													</select>
													break;

												case EditorKind.Number:
													<input type="number" step="any"
														   value="@SpecificationEditor.Read(state.Specification, property.Name)"
														   @onchange="e => SetAsync(sample.Title, state, property.Name, e.Value?.ToString())" />
													break;

												case EditorKind.Colour:
													@* PDColorPicker carries an alpha slider and allows transparency by default. *@
													<PDColorPicker Value="@SpecificationEditor.Read(state.Specification, property.Name)"
														ValueChanged="colour => SetAsync(sample.Title, state, property.Name, colour)" />
													break;

												case EditorKind.ReadOnly:
													<span class="read-only">@SpecificationEditor.Read(state.Specification, property.Name)</span>
													break;

												default:
													<input type="text"
														   value="@SpecificationEditor.Read(state.Specification, property.Name)"
														   @onchange="e => SetAsync(sample.Title, state, property.Name, e.Value?.ToString())" />
													break;
											}

											@if (property.Kind != EditorKind.ReadOnly)
											{
												@*
												    A back-on-itself arrow, always present so the column does not shift as values
												    change, and disabled where there is nothing to undo.
												*@
												<button type="button" class="row-reset"
													disabled="@property.IsDefault"
													title="@(property.IsDefault ? $"{property.Name} is already at its default" : $"Reset {property.Name} to its default")"
													aria-label="Reset @property.Name to its default"
													@onclick="() => ResetPropertyAsync(sample.Title, state, property.Name)">&#8634;</button>
											}
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>

						@*
							The data keeps its own table: it has a column per series rather than a
							name and a value, so folding it into the one above would align nothing.
						*@
						<table class="detail-table data-table">
							<tbody>
								<tr class="section">
									<th colspan="@(state.Data.SeriesNames.Count + 1)">Data</th>
								</tr>
								<tr>
									<th></th>
									@foreach (var name in state.Data.SeriesNames)
									{
										<th scope="col">@name</th>
									}
								</tr>
								@foreach (var row in state.Data.Rows)
								{
									<tr>
										<th scope="row">@row.Category</th>
										@foreach (var value in row.Values)
										{
											<td>@value</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</aside>
				</div>
			</section>
		</PDTab>
	}
</PDTabSet>

@code {
	/// <summary>
	/// A sample's live state: the specification being edited, and the renders of it.
	/// </summary>
	/// <remarks>
	/// The renders are held until something changes rather than recomputed on every re-render:
	/// a single keystroke in one field would otherwise redraw every chart on the page.
	/// </remarks>
	private sealed class SampleState
	{
		public required ChartSpecification Specification { get; set; }

		public bool IsEdited { get; set; }

		public string? Light { get; set; }

		public string? Dark { get; set; }

		public IReadOnlyList<PropertyEditor> Editors { get; set; } = [];

		public DataGrid Data { get; set; } = new([], []);

		public void Invalidate()
		{
			Light = null;
			Dark = null;
			Editors = SpecificationEditor.Describe(Specification);
			Data = SampleDetails.Data(Specification);
		}
	}

	private static readonly (string Value, string Label)[] Modes =
	[
		("auto", "Auto"),
		("light", "Light"),
		("dark", "Dark")
	];

	/// <summary>
	/// The version of the library that rendered these charts, from Nerdbank.GitVersioning.
	/// </summary>
	/// <remarks>
	/// Read from the rendering assembly rather than from this one: the useful question when
	/// looking at a chart is which ChartMagic drew it. The build metadata after the plus sign is
	/// dropped - the version is there to orient the reader, not to identify a build exactly.
	/// </remarks>
	private static string Version { get; } = ReadVersion();

	private IReadOnlyList<ChartSample> _samples = [];
	private readonly Dictionary<string, SampleState> _state = [];
	private string _mode = "auto";

	// The optional comparison against a DocMagic server. Off unless the demo is running locally
	// and has been told where to find one.
	private ComparisonConfiguration _comparison = new(null, null, false);
	/// <summary>
	/// What the DocMagic comparison currently shows for one sample, and what it is doing.
	/// </summary>
	private sealed class ComparisonState
	{
		/// <summary>The last result, or null before the first one.</summary>
		public ComparisonResult? Result { get; set; }

		/// <summary>Whether a render is in flight or waiting out the settling delay.</summary>
		public bool IsRendering { get; set; }

		/// <summary>
		/// The request that produced <see cref="Result"/>, so an unchanged specification is not
		/// sent again - reselecting a tab should cost nothing.
		/// </summary>
		public string? RenderedBody { get; set; }

		/// <summary>
		/// Bumped by every change. A render that finds the token has moved on has been
		/// superseded, and neither draws nor reports - which is what stops a burst of keystrokes
		/// producing a burst of requests, and stops results arriving out of order.
		/// </summary>
		public int Token { get; set; }
	}

	private readonly Dictionary<string, ComparisonState> _comparisons = [];

	/// <summary>
	/// How long to wait for editing to stop before rendering.
	/// </summary>
	/// <remarks>
	/// Every keystroke in a text field is a change, and every change would otherwise be a render
	/// on a remote server. Long enough not to fire mid-word, short enough not to feel deferred.
	/// </remarks>
	private static readonly TimeSpan ComparisonSettleDelay = TimeSpan.FromMilliseconds(500);

	protected override void OnInitialized() => _samples = SampleCharts.All;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		// The mode was already applied to the document by the boot script; this only lights the
		// right button.
		string stored;
		try
		{
			stored = await JS.InvokeAsync<string>("chartMagicDemo.getTheme");
		}
		catch (JSDisconnectedException)
		{
			// The circuit is gone, so there is nothing left to do.
			return;
		}

		if (stored != _mode)
		{
			_mode = stored;
		}

		// Reads the comparison settings out of the query string and remembers them. Does nothing
		// at all unless this is a local host.
		_comparison = await Settings.LoadAsync();
		StateHasChanged();

		// The first tab is already showing, and no tab-selected event will fire for it, so it
		// would otherwise sit unrendered until the reader touched something.
		if (_comparison.IsConfigured && _samples.Count > 0)
		{
			await ScheduleComparisonAsync(_samples[0].Title);
		}
	}

	private async Task SetModeAsync(string mode)
	{
		_mode = mode;
		try
		{
			await JS.InvokeVoidAsync("chartMagicDemo.setTheme", mode);
		}
		catch (JSDisconnectedException)
		{
			// The circuit is gone, so there is nothing left to do.
		}
	}

	/// <summary>
	/// The comparison state for a sample, created on first use.
	/// </summary>
	private ComparisonState ComparisonFor(string title)
	{
		if (!_comparisons.TryGetValue(title, out var state))
		{
			state = new ComparisonState();
			_comparisons[title] = state;
		}

		return state;
	}

	/// <summary>
	/// Renders a sample on the DocMagic server once editing has settled.
	/// </summary>
	/// <remarks>
	/// Started by anything that changes what is on screen: an edit, a reset, or selecting a tab.
	/// Nothing has to be clicked.
	///
	/// Two things keep that from being expensive. Only the selected tab exists in the document at
	/// all, so a page of thirty-odd samples is never thirty-odd renders; and a token bumped by each
	/// change means a burst of keystrokes results in one render, of the state the typing ended in.
	/// </remarks>
	private async Task ScheduleComparisonAsync(string title, bool force = false)
	{
		if (!_comparison.IsConfigured)
		{
			return;
		}

		var state = ComparisonFor(title);
		var token = ++state.Token;
		state.IsRendering = true;

		await Task.Delay(ComparisonSettleDelay);

		// Superseded while waiting: the later change owns the render.
		if (token != state.Token)
		{
			return;
		}

		string body;
		try
		{
			body = DocMagicRequest.Build(_state[title].Specification, SampleCharts.WidthPixels, SampleCharts.HeightPixels);
		}
		catch (NotSupportedException ex)
		{
			// Something in the specification has no counterpart on the endpoint. Reported rather
			// than approximated, because a chart drawn from a substituted value would look like a
			// rendering difference.
			Finish(state, new ComparisonResult(null, ex.Message), renderedBody: null);
			return;
		}

		// An unchanged specification needs no round trip, which is what makes reselecting a tab
		// free.
		if (!force && body == state.RenderedBody && state.Result is not null)
		{
			state.IsRendering = false;
			StateHasChanged();
			return;
		}

		var apiKey = await Settings.ReadApiKeyAsync();
		if (apiKey is not { Length: > 0 })
		{
			Finish(state, new ComparisonResult(null, "No API key stored."), renderedBody: null);
		}
		else
		{
			var result = await Comparer.RenderAsync(
				_comparison,
				apiKey,
				_state[title].Specification,
				SampleCharts.WidthPixels,
				SampleCharts.HeightPixels,
				CancellationToken.None);

			if (token != state.Token)
			{
				// Changed again while this was in flight. Dropping it stops a slow render painting
				// over a newer one.
				return;
			}

			// A failed render does not count as rendered, so the next change tries again rather
			// than deciding nothing has changed.
			Finish(state, result, result.HasImage ? body : null);
		}
	}

	private void Finish(ComparisonState state, ComparisonResult result, string? renderedBody)
	{
		state.Result = result;
		state.RenderedBody = renderedBody;
		state.IsRendering = false;
		StateHasChanged();
	}

	/// <summary>
	/// Renders the newly selected sample, if it is not already showing the current one.
	/// </summary>
	private Task OnTabSelectedAsync(PDTab tab)
		=> tab.Title is { Length: > 0 } title ? ScheduleComparisonAsync(title) : Task.CompletedTask;

	/// <summary>
	/// Renders again after a failure, which is the one case worth a button.
	/// </summary>
	private Task RetryComparisonAsync(string title) => ScheduleComparisonAsync(title, force: true);
	/// <summary>
	/// Forgets the stored server and key, so a key need not outlive the session.
	/// </summary>
	private async Task ForgetSettingsAsync()
	{
		await Settings.ForgetAsync();
		_comparison = await Settings.ReadAsync();
		_comparisons.Clear();
	}

	private SampleState StateFor(ChartSample sample)
	{
		if (_state.TryGetValue(sample.Title, out var existing))
		{
			return existing;
		}

		var state = new SampleState { Specification = sample.Specification };
		state.Invalidate();
		_state[sample.Title] = state;
		return state;
	}

	private static string LightSvg(SampleState state)
		=> state.Light ??= SampleCharts.ToSvg(state.Specification, ChartTheme.Light);

	private static string DarkSvg(SampleState state)
		=> state.Dark ??= SampleCharts.ToSvg(state.Specification, ChartTheme.Dark);

	/// <summary>
	/// Applies an edit and redraws. A value that will not parse is ignored, because half-typed
	/// input is normal when the chart is redrawing as you type.
	/// </summary>
	private async Task SetAsync(string title, SampleState state, string name, string? value)
	{
		if (!SpecificationEditor.Write(state.Specification, name, value))
		{
			return;
		}

		state.IsEdited = true;
		state.Invalidate();

		await ScheduleComparisonAsync(title);
	}

	/// <summary>
	/// Puts one property back to its default, leaving the rest of the sample alone.
	/// </summary>
	private async Task ResetPropertyAsync(string title, SampleState state, string name)
	{
		if (SpecificationEditor.ResetToDefault(state.Specification, name))
		{
			state.Invalidate();
			await ScheduleComparisonAsync(title);
		}
	}

	/// <summary>
	/// Puts a sample back to the specification it shipped with, by rebuilding it.
	/// </summary>
	private async Task ResetAsync(string title)
	{
		var sample = SampleCharts.All.FirstOrDefault(s => s.Title == title);
		if (sample is null)
		{
			return;
		}

		var state = new SampleState { Specification = sample.Specification };
		state.Invalidate();
		_state[title] = state;

		await ScheduleComparisonAsync(title);
	}

	/// <summary>
	/// Group names are prefixed with a sort key so the groups appear in layout order rather than
	/// alphabetically; the key is not shown.
	/// </summary>
	private static string GroupLabel(string group) => group.Length > 2 ? group[2..] : group;

	private static string ReadVersion()
	{
		var informational = typeof(Chart).Assembly
			.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
			?.InformationalVersion;

		if (informational is not { Length: > 0 })
		{
			return string.Empty;
		}

		var plus = informational.IndexOf('+', StringComparison.Ordinal);
		return plus < 0 ? informational : informational[..plus];
	}

	private static string BadgeClass(SampleStatus status) => status switch
	{
		SampleStatus.Working => "working",
		SampleStatus.Partial => "partial",
		_ => "missing"
	};

	private static string BadgeText(SampleStatus status) => status switch
	{
		SampleStatus.Working => "Working",
		SampleStatus.Partial => "Partial",
		_ => "Not implemented"
	};
}
